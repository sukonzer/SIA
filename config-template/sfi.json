{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "local",
        "type": "local",
        "prefer_go": true
      },
      {
        "tag": "ali",
        "type": "https",
        "server": "223.5.5.5"
      },
      {
        "tag": "tx",
        "type": "https",
        "server": "doh.pub",
        "domain_resolver": "hosts"
      },
      {
        "tag": "google",
        "type": "https",
        "server": "8.8.8.8",
        "detour": "🎯 Node"
      },
      {
        "tag": "fakeip",
        "type": "fakeip",
        "inet4_range": "198.19.0.0/16"
      },
      {
        "type": "hosts",
        "tag": "hosts",
        "predefined": {
          "doh.pub": [
            "1.12.12.21",
            "120.53.53.53"
          ]
        }
      }
    ],
    "rules": [
      {
        "query_type": [
          "HTTPS",
          "SVCB"
        ],
        "action": "reject"
      },
      {
        "clash_mode": "Direct",
        "server": "ali"
      },
      {
        "clash_mode": "Global",
        "server": "fakeip"
      },
      {
        "rule_set": [
          "fakeipfilter-cn",
          "geosite-cn",
          "geosite-microsoft@cn",
          "geosite-apple@cn",
          "geosite-private"
        ],
        "server": "ali"
      },
      {
        "rule_set": "fakeipfilter-!cn",
        "server": "google"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "query_type": [
              "A",
              "AAAA"
            ]
          },
          {
            "rule_set": "geosite-geolocation-!cn",
            "invert": true
          }
        ],
        "action": "evaluate",
        "server": "google",
        "client_subnet": "223.5.5.0/24",
        "timeout": "2s"
      },
      {
        "match_response": true,
        "rule_set": "geoip-cn",
        "server": "ali"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "fakeip",
        "rewrite_ttl": 1
      }
    ],
    "final": "google",
    "strategy": "ipv4_only",
    "cache_capacity": 8192,
    "optimistic": {
      "enabled": true
    },
    "reverse_mapping": true
  },
  "http_clients": [
    {
      "tag": "📥 Download",
      "detour": "🟢 Direct"
    }
  ],
  "ntp": {
    "enabled": true,
    "interval": "30m0s",
    "server": "ntp.aliyun.com",
    "server_port": 123
  },
  "inbounds": [
    {
      "tag": "mixed-in",
      "type": "mixed",
      "listen": "::",
      "listen_port": 7890,
      "set_system_proxy": false
    },
    {
      "tag": "tun-in",
      "type": "tun",
      "address": [
        "172.18.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "auto_route": true,
      "strict_route": true
    }
  ],
  "outbounds": [
    {
      "tag": "🎯 Node",
      "type": "selector",
      "outbounds": [
        "🌐 Proxy",
        "🚄 Auto",
        "🟢 Direct"
      ]
    },
    {
      "tag": "🔍 Google",
      "type": "selector",
      "outbounds": [
        "🇺🇲 USA",
        "🔯 Nearby",
        "🌐 Proxy"
      ]
    },
    {
      "tag": "📹 YouTube",
      "type": "selector",
      "outbounds": [
        "🌐 Proxy",
        "🚄 Auto",
        "🔯 Nearby",
        "🇺🇲 USA"
      ]
    },
    {
      "tag": "🤖 AI",
      "type": "selector",
      "outbounds": [
        "🇺🇲 USA",
        "🇸🇬 SGP",
        "🌐 Proxy"
      ]
    },
    {
      "tag": "🎥 Netflix",
      "type": "selector",
      "outbounds": [
        "🚄 Auto",
        "🌐 Proxy",
        "🔯 Nearby",
        "🇺🇲 USA"
      ]
    },
    {
      "tag": "📲 Telegram",
      "type": "selector",
      "outbounds": [
        "🔯 Nearby",
        "🇺🇲 USA",
        "🚄 Auto",
        "🌐 Proxy"
      ]
    },
    {
      "tag": "🔯 Nearby",
      "type": "selector",
      "outbounds": [
        "{all}"
      ],
      "include": [
        "🇭🇰|HK|hk|香港|港|HongKong",
        "🇲🇴|MO|mo|澳门|macau|Macau",
        "🇹🇼|TW|tw|台湾|臺灣|台|Taiwan",
        "🇯🇵|JP|jp|日本|日本国|日|Japan",
        "🇰🇷|KR|kr|韩国|韩|Korea",
        "🇸🇬|SG|sg|singapore|新加坡|坡县"
      ]
    },
    {
      "tag": "🇸🇬 SGP",
      "type": "selector",
      "outbounds": [
        "{all}"
      ],
      "include": [
        "🇸🇬|SG|sg|singapore|新加坡|坡县"
      ]
    },
    {
      "tag": "🇺🇲 USA",
      "type": "selector",
      "outbounds": [
        "{all}"
      ],
      "include": [
        "🇺🇸|US|us|美国|美|United States"
      ]
    },
    {
      "tag": "🏢 Pure",
      "type": "selector",
      "outbounds": [
        "{all}"
      ],
      "include": [
        "🏡|🏢"
      ]
    },
    {
      "tag": "🔀 Other",
      "type": "selector",
      "outbounds": [
        "🌐 Proxy",
        "🚄 Auto"
      ]
    },
    {
      "tag": "🌐 Proxy",
      "type": "selector",
      "outbounds": [
        "{all}"
      ],
      "exclude": [
        "网站|官网|地址|剩余|过期|到期|时间|有效|tg|群|订阅|刷新"
      ]
    },
    {
      "tag": "🚄 Auto",
      "type": "urltest",
      "outbounds": [
        "{all}"
      ],
      "exclude": [
        "网站|官网|地址|剩余|过期|到期|时间|有效|tg|群|订阅|刷新",
        "🇭🇰|HK|hk|香港|港|HongKong",
        "🇲🇴|MO|mo|澳门|macau|Macau",
        "🇹🇼|TW|tw|台湾|臺灣|台|Taiwan",
        "🇯🇵|JP|jp|日本|日本国|日|Japan",
        "🇰🇷|KR|kr|韩国|韩|Korea",
        "🇸🇬|SG|sg|singapore|新加坡|坡县"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "10m",
      "tolerance": 50
    },
    {
      "tag": "🟢 Direct",
      "type": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "domain_suffix": "push.apple.com"
          },
          {
            "rule_set": "geoip-telegram"
          }
        ],
        "invert": true,
        "action": "sniff",
        "sniffer": [
          "http",
          "tls",
          "stun",
          "quic",
          "dns"
        ],
        "timeout": "100ms"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 53
          },
          {
            "protocol": "dns"
          }
        ],
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "outbound": "🟢 Direct"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 853
          },
          {
            "protocol": [
              "stun",
              "quic"
            ]
          }
        ],
        "action": "reject",
        "no_drop": true
      },
      {
        "network": "icmp",
        "action": "resolve"
      },
      {
        "network": "icmp",
        "outbound": "🟢 Direct"
      },
      {
        "clash_mode": "Direct",
        "outbound": "🟢 Direct"
      },
      {
        "clash_mode": "Global",
        "outbound": "🌐 Proxy"
      },
      {
        "rule_set": "geosite-private",
        "outbound": "🟢 Direct"
      },
      {
        "rule_set": "geosite-category-ai-!cn",
        "outbound": "🤖 AI"
      },
      {
        "rule_set": "geosite-youtube",
        "outbound": "📹 YouTube"
      },
      {
        "rule_set": "geosite-google",
        "outbound": "🔍 Google"
      },
      {
        "rule_set": "geosite-github",
        "outbound": "🔍 Google"
      },
      {
        "rule_set": "geosite-onedrive",
        "outbound": "🟢 Direct"
      },
      {
        "rule_set": "geosite-microsoft@cn",
        "outbound": "🟢 Direct"
      },
      {
        "rule_set": "geosite-apple@cn",
        "outbound": "🟢 Direct"
      },
      {
        "rule_set": "geosite-telegram",
        "outbound": "📲 Telegram"
      },
      {
        "rule_set": "geosite-tiktok",
        "outbound": "📹 YouTube"
      },
      {
        "rule_set": "geosite-netflix",
        "outbound": "🎥 Netflix"
      },
      {
        "rule_set": "geosite-paypal",
        "outbound": "🌐 Proxy"
      },
      {
        "rule_set": "geosite-binance",
        "outbound": "🌐 Proxy"
      },
      {
        "rule_set": "geosite-category-cryptocurrency",
        "outbound": "🌐 Proxy"
      },
      {
        "rule_set": "geosite-steam@cn",
        "outbound": "🟢 Direct"
      },
      {
        "rule_set": "geosite-steam",
        "outbound": "🟢 Direct"
      },
      {
        "rule_set": "geosite-geolocation-!cn",
        "outbound": "🎯 Node"
      },
      {
        "inbound": "mixed-in",
        "action": "resolve"
      },
      {
        "rule_set": "geoip-telegram",
        "outbound": "📲 Telegram"
      },
      {
        "rule_set": "geoip-cn",
        "outbound": "🟢 Direct"
      }
    ],
    "rule_set": [
      {
        "tag": [
          "fakeipfilter-cn",
          "fakeipfilter-!cn"
        ],
        "type": "remote",
        "format": "source",
        "url": "https://gh-proxy.com/https://raw.githubusercontent.com/qichiyuhub/rule/refs/heads/main/rules/{tag}.json"
      },
      {
        "tag": [
          "geosite-category-ai-!cn",
          "geosite-youtube",
          "geosite-google",
          "geosite-github",
          "geosite-onedrive",
          "geosite-microsoft@cn",
          "geosite-apple@cn",
          "geosite-telegram",
          "geosite-tiktok",
          "geosite-netflix",
          "geosite-paypal",
          "geosite-binance",
          "geosite-category-cryptocurrency",
          "geosite-steam@cn",
          "geosite-steam",
          "geosite-geolocation-!cn",
          "geosite-cn",
          "geosite-private"
        ],
        "type": "remote",
        "format": "binary",
        "url": "https://gh-proxy.com/https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/{tag}.srs"
      },
      {
        "tag": "geoip-telegram",
        "type": "remote",
        "format": "binary",
        "url": "https://gh-proxy.com/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geoip/telegram.srs"
      },
      {
        "tag": "geoip-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://gh-proxy.com/https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs"
      }
    ],
    "final": "🎯 Node",
    "default_http_client": "📥 Download",
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "ali"
    }
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_fakeip": true,
      "store_dns": true
    }
  }
}