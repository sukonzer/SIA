{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "proxy_server_dns",
        "domain_resolver": "hosts_dns",
        "server": "doh.pub"
      },
      {
        "type": "quic",
        "tag": "direct_dns",
        "domain_resolver": "hosts_dns",
        "server": "dns.alidns.com"
      },
      {
        "type": "h3",
        "tag": "proxy_dns",
        "detour": "🎯 Node",
        "domain_resolver": "hosts_dns",
        "server": "dns.google"
      },
      {
        "type": "local",
        "tag": "local_dns"
      },
      {
        "type": "fakeip",
        "tag": "fakeip_dns",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/64"
      },
      {
        "type": "hosts",
        "tag": "hosts_dns",
        "predefined": {
          "dns.alidns.com": [
            "223.5.5.5",
            "223.6.6.6",
            "2400:3200::1",
            "2400:3200:baba::1"
          ],
          "doh.pub": [
            "1.12.12.21",
            "120.53.53.53",
            "2402:4e00::"
          ],
          "dns.google": [
            "8.8.8.8",
            "8.8.4.4",
            "2001:4860:4860::8888",
            "2001:4860:4860::8844"
          ],
          "cloudflare-dns.com": [
            "104.16.248.249",
            "104.16.249.249",
            "2606:4700:4700::1111",
            "2606:4700:4700::1001"
          ]
        }
      }
    ],
    "rules": [
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "query_type": "AAAA"
          },
          {
            "default_interface_address": "2000::/3",
            "invert": true
          }
        ],
        "action": "reject"
      },
      {
        "domain_suffix": [
          "cloudflare-ech.com"
        ],
        "server": "direct_dns"
      },
      {
        "clash_mode": "Direct",
        "server": "direct_dns"
      },
      {
        "clash_mode": "Global",
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "fakeip_dns",
        "rewrite_ttl": 1
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "server": "proxy_dns"
      },
      {
        "query_type": [
          "SVCB",
          "HTTPS",
          "PTR"
        ],
        "action": "predefined",
        "rcode": "NOERROR"
      },
      {
        "domain_suffix": [
          ".local",
          ".lan",
          ".home",
          "router.asus.com",
          "tplinkwifi.net",
          "tplinklogin.net",
          "miwifi.com",
          "peiluyou.com",
          "tendawifi.com",
          "market.xiaomi.com",
          "lancache.steamcontent.com",
          "tracking.miui.com",
          "steamserver.net"
        ],
        "rule_set": "geosite-private",
        "server": "local_dns"
      },
      {
        "rule_set": "geosite-cn",
        "server": "direct_dns"
      },
      {
        "rule_set": "geosite-geolocation-!cn",
        "server": "proxy_dns"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "fakeip_dns",
        "rewrite_ttl": 1
      }
    ],
    "strategy": "ipv4_only",
    "final": "proxy_dns",
    "cache_capacity": 16384,
    "optimistic": {
      "enabled": true,
      "timeout": "5m0s"
    }
  },
  "http_clients": [
    {
      "tag": "default",
      "version": 2,
      "stream_receive_window": 0,
      "connection_receive_window": 0
    }
  ],
  "ntp": {
    "enabled": true,
    "interval": "30m0s",
    "server": "ntp.aliyun.com",
    "server_port": 123
  },
  "inbounds": [
    {
      "type": "tun",
      "address": [
        "172.19.0.0/30",
        "fdfe:dcba:9876::/126"
      ],
      "auto_route": true,
      "stack": "mixed",
      "platform": {
        "http_proxy": {
          "enabled": true,
          "server": "127.0.0.1",
          "server_port": 7890
        }
      }
    },
    {
      "type": "mixed",
      "listen": "127.0.0.1",
      "listen_port": 7890
    }
  ],
  "outbounds": [
    {
      "tag": "🎯 Node",
      "type": "selector",
      "outbounds": [
        "🌐 Proxy",
        "🔯 Nearby",
        "🇺🇲 USA",
        "🚄 Auto",
        "🎯 Direct"
      ]
    },
    {
      "tag": "🔍 Google",
      "type": "selector",
      "outbounds": [
        "🇺🇲 USA",
        "🔯 Nearby",
        "🌐 Proxy"
      ]
    },
    {
      "tag": "📹 YouTube",
      "type": "selector",
      "outbounds": [
        "🌐 Proxy",
        "🚄 Auto",
        "🔯 Nearby",
        "🇺🇲 USA"
      ]
    },
    {
      "tag": "🤖 AI",
      "type": "selector",
      "outbounds": [
        "🇸🇬 SGP",
        "🇺🇲 USA",
        "🌐 Proxy"
      ]
    },
    {
      "tag": "🎥 Netflix",
      "type": "selector",
      "outbounds": [
        "🚄 Auto",
        "🌐 Proxy",
        "🔯 Nearby",
        "🇺🇲 USA"
      ]
    },
    {
      "tag": "📲 Telegram",
      "type": "selector",
      "outbounds": [
        "🔯 Nearby",
        "🇺🇲 USA",
        "🚄 Auto",
        "🌐 Proxy"
      ]
    },
    {
      "tag": "🔯 Nearby",
      "type": "selector",
      "outbounds": [
        "{all}"
      ],
      "filter": [
        {
          "action": "include",
          "keywords": [
            "🇭🇰|HK|hk|香港|港|HongKong",
            "🇲🇴|MO|mo|澳门|macau|Macau",
            "🇹🇼|TW|tw|台湾|臺灣|台|Taiwan",
            "🇯🇵|JP|jp|日本|日本国|日|Japan",
            "🇰🇷|KR|kr|韩国|韩|Korea",
            "🇸🇬|SG|sg|singapore|新加坡|坡县"
          ]
        }
      ]
    },
    {
      "tag": "🇸🇬 SGP",
      "type": "selector",
      "outbounds": [
        "{all}"
      ],
      "filter": [
        {
          "action": "include",
          "keywords": [
            "🇸🇬|SG|sg|singapore|新加坡|坡县"
          ]
        }
      ]
    },
    {
      "tag": "🇺🇲 USA",
      "type": "selector",
      "outbounds": [
        "{all}"
      ],
      "filter": [
        {
          "action": "include",
          "keywords": [
            "🇺🇸|US|us|美国|美|United States"
          ]
        }
      ]
    },
    {
      "tag": "🔀 Other",
      "type": "selector",
      "outbounds": [
        "🌐 Proxy",
        "🔯 Nearby",
        "🇺🇲 USA",
        "🚄 Auto"
      ]
    },
    {
      "tag": "🌐 Proxy",
      "type": "selector",
      "outbounds": [
        "{all}"
      ],
      "filter": [
        {
          "action": "exclude",
          "keywords": [
            "网站|官网|地址|剩余|过期|到期|时间|有效|tg|群|订阅|刷新"
          ]
        }
      ]
    },
    {
      "tag": "🚄 Auto",
      "type": "urltest",
      "outbounds": [
        "{all}"
      ],
      "filter": [
        {
          "action": "exclude",
          "keywords": [
            "网站|官网|地址|剩余|过期|到期|时间|有效|tg|群|订阅|刷新",
            "🇭🇰|HK|hk|香港|港|HongKong",
            "🇲🇴|MO|mo|澳门|macau|Macau",
            "🇹🇼|TW|tw|台湾|臺灣|台|Taiwan",
            "🇯🇵|JP|jp|日本|日本国|日|Japan",
            "🇰🇷|KR|kr|韩国|韩|Korea",
            "🇸🇬|SG|sg|singapore|新加坡|坡县"
          ]
        }
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "10m",
      "tolerance": 50
    },
    {
      "tag": "🎯 Direct",
      "type": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "ip_version": 6
          },
          {
            "default_interface_address": [
              "2000::/3"
            ],
            "invert": true
          }
        ],
        "action": "reject"
      },
      {
        "action": "sniff",
        "timeout": "500ms"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 53
          },
          {
            "protocol": "dns"
          }
        ],
        "action": "hijack-dns"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "ip_is_private": true
          },
          {
            "ip_cidr": [
              "198.18.0.0/15",
              "fc00::/64"
            ],
            "invert": true
          }
        ],
        "outbound": "🎯 Direct"
      },
      {
        "clash_mode": "Direct",
        "outbound": "🎯 Direct"
      },
      {
        "clash_mode": "Global",
        "outbound": "🌐 Proxy"
      },
      {
        "domain_suffix": [
          "ping0.cc",
          "ippure.com",
          "ip.sb",
          "iplark.com",
          "speedtest.net",
          "fiber.google.com",
          "fast.com"
        ],
        "outbound": "🔀 Other"
      },
      {
        "rule_set": [
          "geoip-google",
          "geosite-google",
          "geosite-github"
        ],
        "outbound": "🔍 Google"
      },
      {
        "domain_suffix": [
          "integrate.api.nvidia.com",
          "openai.good.hidns.vip"
        ],
        "rule_set": "geosite-ai",
        "outbound": "🤖 AI"
      },
      {
        "rule_set": [
          "geosite-youtube",
          "geosite-tiktok"
        ],
        "outbound": "📹 YouTube"
      },
      {
        "rule_set": [
          "geoip-telegram",
          "geosite-telegram"
        ],
        "outbound": "📲 Telegram"
      },
      {
        "rule_set": [
          "geoip-netflix",
          "geosite-netflix"
        ],
        "outbound": "🎥 Netflix"
      },
      {
        "domain_regex": "^(.+\\.)?kaspersky\\.com$",
        "outbound": "🎯 Direct"
      },
      {
        "rule_set": "geosite-geolocation-!cn",
        "outbound": "🎯 Node"
      },
      {
        "rule_set": [
          "geoip-cn",
          "geosite-cn"
        ],
        "outbound": "🎯 Direct"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "geosite-ai",
        "url": "https://gh-proxy.com/raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/category-ai-!cn.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-youtube",
        "url": "https://gh-proxy.com/raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo-lite/geosite/youtube.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-google",
        "url": "https://gh-proxy.com/raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo-lite/geosite/google.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-github",
        "url": "https://gh-proxy.com/raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo-lite/geosite/github.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-telegram",
        "url": "https://gh-proxy.com/raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo-lite/geosite/telegram.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-tiktok",
        "url": "https://gh-proxy.com/raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo-lite/geosite/tiktok.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-netflix",
        "url": "https://gh-proxy.com/raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo-lite/geosite/netflix.srs"
      },
      {
        "type": "remote",
        "tag": "geoip-google",
        "url": "https://gh-proxy.com/raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo-lite/geoip/google.srs"
      },
      {
        "type": "remote",
        "tag": "geoip-telegram",
        "url": "https://gh-proxy.com/raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo-lite/geoip/telegram.srs"
      },
      {
        "type": "remote",
        "tag": "geoip-netflix",
        "url": "https://gh-proxy.com/raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo-lite/geoip/netflix.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-geolocation-!cn",
        "url": "https://gh-proxy.com/raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-geolocation-!cn.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-cn",
        "url": "https://gh-proxy.com/raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-cn.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-private",
        "url": "https://gh-proxy.com/raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-private.srs"
      },
      {
        "type": "remote",
        "tag": "geoip-cn",
        "url": "https://gh-proxy.com/raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs"
      }
    ],
    "final": "🎯 Node",
    "auto_detect_interface": true,
    "default_domain_resolver": "proxy_server_dns",
    "default_http_client": "default"
  },
  "services": [
    {
      "type": "api",
      "listen": "::",
      "listen_port": 9900,
      "access_control_allow_origin": "*",
      "access_control_allow_private_network": true,
      "dashboard": true
    }
  ]
}