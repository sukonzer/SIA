{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "local",
        "type": "local"
      },
      {
        "tag": "direct_dns",
        "type": "https",
        "server": "223.5.5.5",
        "tls": {
          "server_name": "dns.alidns.com"
        }
      },
      {
        "tag": "proxy_server_dns",
        "type": "https",
        "server": "1.12.12.12",
        "tls": {
          "server_name": "doh.pub"
        }
      },
      {
        "tag": "proxy_dns",
        "type": "https",
        "server": "8.8.8.8",
        "detour": "🎯 Node"
      },
      {
        "tag": "fakeip_dns",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],
    "rules": [
      {
        "domain_suffix": [
          ".local",
          ".lan",
          ".home",
          "router.asus.com",
          "tplinkwifi.net",
          "tplinklogin.net",
          "miwifi.com",
          "peiluyou.com",
          "tendawifi.com",
          "market.xiaomi.com",
          "lancache.steamcontent.com",
          "tracking.miui.com",
          "steamserver.net"
        ],
        "rule_set": "geosite-private",
        "server": "local"
      },
      {
        "domain_suffix": [
          "cloudflare-ech.com"
        ],
        "server": "direct_dns"
      },
      {
        "clash_mode": "direct",
        "server": "direct_dns"
      },
      {
        "query_type": "HTTPS",
        "action": "predefined",
        "rcode": "NOERROR"
      },
      {
        "clash_mode": "global",
        "server": "fakeip_dns"
      },
      {
        "rule_set": "geosite-cn",
        "server": "direct_dns"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "action": "evaluate",
        "server": "direct_dns"
      },
      {
        "match_response": true,
        "rule_set": "geoip-cn",
        "action": "respond"
      },
      {
        "query_type": "AAAA",
        "rule_set": "geosite-geolocation-!cn",
        "action": "reject"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "fakeip_dns",
        "rewrite_ttl": 1
      }
    ],
    "final": "proxy_dns",
    "optimistic": true,
    "reverse_mapping": true
  },
  "http_clients": [
    {
      "tag": "default",
      "version": 2,
      "stream_receive_window": 0,
      "connection_receive_window": 0
    }
  ],
  "ntp": {
    "enabled": true,
    "interval": "30m0s",
    "server": "ntp.aliyun.com",
    "server_port": 123
  },
  "inbounds": [
    {
      "tag": "mixed-in",
      "type": "mixed",
      "listen": "::",
      "listen_port": 7890,
      "set_system_proxy": false
    },
    {
      "tag": "tun-in",
      "type": "tun",
      "address": [
        "172.18.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "auto_route": true,
      "strict_route": true
    }
  ],
  "outbounds": [
    {
      "tag": "🎯 Node",
      "type": "selector",
      "outbounds": [
        "🌐 Proxy",
        "🔯 Nearby",
        "🇺🇲 USA",
        "🚄 Auto",
        "🎯 Direct"
      ]
    },
    {
      "tag": "🔍 Google",
      "type": "selector",
      "outbounds": [
        "🇺🇲 USA",
        "🔯 Nearby",
        "🌐 Proxy"
      ]
    },
    {
      "tag": "📹 YouTube",
      "type": "selector",
      "outbounds": [
        "🌐 Proxy",
        "🚄 Auto",
        "🔯 Nearby",
        "🇺🇲 USA"
      ]
    },
    {
      "tag": "🤖 AI",
      "type": "selector",
      "outbounds": [
        "🇸🇬 SGP",
        "🇺🇲 USA",
        "🌐 Proxy"
      ]
    },
    {
      "tag": "🎥 Netflix",
      "type": "selector",
      "outbounds": [
        "🚄 Auto",
        "🌐 Proxy",
        "🔯 Nearby",
        "🇺🇲 USA"
      ]
    },
    {
      "tag": "📲 Telegram",
      "type": "selector",
      "outbounds": [
        "🔯 Nearby",
        "🇺🇲 USA",
        "🚄 Auto",
        "🌐 Proxy"
      ]
    },
    {
      "tag": "🔯 Nearby",
      "type": "selector",
      "outbounds": [
        "{all}"
      ],
      "filter": [
        {
          "action": "include",
          "keywords": [
            "🇭🇰|HK|hk|香港|港|HongKong",
            "🇲🇴|MO|mo|澳门|macau|Macau",
            "🇹🇼|TW|tw|台湾|臺灣|台|Taiwan",
            "🇯🇵|JP|jp|日本|日本国|日|Japan",
            "🇰🇷|KR|kr|韩国|韩|Korea",
            "🇸🇬|SG|sg|singapore|新加坡|坡县"
          ]
        }
      ]
    },
    {
      "tag": "🇸🇬 SGP",
      "type": "selector",
      "outbounds": [
        "{all}"
      ],
      "filter": [
        {
          "action": "include",
          "keywords": [
            "🇸🇬|SG|sg|singapore|新加坡|坡县"
          ]
        }
      ]
    },
    {
      "tag": "🇺🇲 USA",
      "type": "selector",
      "outbounds": [
        "{all}"
      ],
      "filter": [
        {
          "action": "include",
          "keywords": [
            "🇺🇸|US|us|美国|美|United States"
          ]
        }
      ]
    },
    {
      "tag": "🔀 Other",
      "type": "selector",
      "outbounds": [
        "🌐 Proxy",
        "🔯 Nearby",
        "🇺🇲 USA",
        "🚄 Auto"
      ]
    },
    {
      "tag": "🌐 Proxy",
      "type": "selector",
      "outbounds": [
        "{all}"
      ],
      "filter": [
        {
          "action": "exclude",
          "keywords": [
            "网站|官网|地址|剩余|过期|到期|时间|有效|tg|群|订阅|刷新"
          ]
        }
      ]
    },
    {
      "tag": "🚄 Auto",
      "type": "urltest",
      "outbounds": [
        "{all}"
      ],
      "filter": [
        {
          "action": "exclude",
          "keywords": [
            "网站|官网|地址|剩余|过期|到期|时间|有效|tg|群|订阅|刷新",
            "🇭🇰|HK|hk|香港|港|HongKong",
            "🇲🇴|MO|mo|澳门|macau|Macau",
            "🇹🇼|TW|tw|台湾|臺灣|台|Taiwan",
            "🇯🇵|JP|jp|日本|日本国|日|Japan",
            "🇰🇷|KR|kr|韩国|韩|Korea",
            "🇸🇬|SG|sg|singapore|新加坡|坡县"
          ]
        }
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "10m",
      "tolerance": 50
    },
    {
      "tag": "🎯 Direct",
      "type": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 53
          },
          {
            "protocol": "dns"
          }
        ],
        "action": "hijack-dns"
      },
      {
        "port": 853,
        "action": "reject",
        "no_drop": true
      },
      {
        "clash_mode": "direct",
        "outbound": "🎯 Direct"
      },
      {
        "clash_mode": "global",
        "outbound": "🌐 Proxy"
      },
      {
        "domain_suffix": [
          "ping0.cc",
          "ippure.com",
          "ip.sb",
          "iplark.com",
          "speedtest.net",
          "fiber.google.com",
          "fast.com"
        ],
        "outbound": "🔀 Other"
      },
      {
        "rule_set": [
          "geosite-google",
          "geosite-github"
        ],
        "outbound": "🔍 Google"
      },
      {
        "domain_suffix": [
          "integrate.api.nvidia.com",
          "openai.good.hidns.vip"
        ],
        "rule_set": "geosite-ai",
        "outbound": "🤖 AI"
      },
      {
        "rule_set": [
          "geosite-youtube",
          "geosite-tiktok"
        ],
        "outbound": "📹 YouTube"
      },
      {
        "rule_set": "geosite-telegram",
        "outbound": "📲 Telegram"
      },
      {
        "rule_set": "geosite-netflix",
        "outbound": "🎥 Netflix"
      },
      {
        "domain_regex": "^(.+\\.)?kaspersky\\.com$",
        "outbound": "🎯 Direct"
      },
      {
        "rule_set": "geosite-geolocation-!cn",
        "protocol": [
          "quic",
          "stun"
        ],
        "action": "reject",
        "no_drop": true
      },
      {
        "rule_set": "geosite-geolocation-!cn",
        "outbound": "🎯 Node"
      },
      {
        "rule_set": "geosite-cn",
        "outbound": "🎯 Direct"
      },
      {
        "action": "resolve"
      },
      {
        "ip_is_private": true,
        "outbound": "🎯 Direct"
      },
      {
        "rule_set": "geoip-google",
        "outbound": "🔍 Google"
      },
      {
        "rule_set": "geoip-telegram",
        "outbound": "📲 Telegram"
      },
      {
        "rule_set": "geoip-netflix",
        "outbound": "🎥 Netflix"
      },
      {
        "rule_set": "geoip-cn",
        "outbound": "🎯 Direct"
      },
      {
        "protocol": [
          "quic",
          "stun"
        ],
        "action": "reject",
        "no_drop": true
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "geosite-ai",
        "url": "https://gh-proxy.com/raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/category-ai-!cn.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-youtube",
        "url": "https://gh-proxy.com/raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo-lite/geosite/youtube.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-google",
        "url": "https://gh-proxy.com/raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo-lite/geosite/google.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-github",
        "url": "https://gh-proxy.com/raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo-lite/geosite/github.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-telegram",
        "url": "https://gh-proxy.com/raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo-lite/geosite/telegram.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-tiktok",
        "url": "https://gh-proxy.com/raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo-lite/geosite/tiktok.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-netflix",
        "url": "https://gh-proxy.com/raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo-lite/geosite/netflix.srs"
      },
      {
        "type": "remote",
        "tag": "geoip-google",
        "url": "https://gh-proxy.com/raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo-lite/geoip/google.srs"
      },
      {
        "type": "remote",
        "tag": "geoip-telegram",
        "url": "https://gh-proxy.com/raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo-lite/geoip/telegram.srs"
      },
      {
        "type": "remote",
        "tag": "geoip-netflix",
        "url": "https://gh-proxy.com/raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo-lite/geoip/netflix.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-geolocation-!cn",
        "url": "https://gh-proxy.com/raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-geolocation-!cn.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-cn",
        "url": "https://gh-proxy.com/raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-cn.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-private",
        "url": "https://gh-proxy.com/raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-private.srs"
      },
      {
        "type": "remote",
        "tag": "geoip-cn",
        "url": "https://gh-proxy.com/raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs"
      }
    ],
    "final": "🎯 Node",
    "auto_detect_interface": true,
    "default_domain_resolver": "proxy_server_dns",
    "default_http_client": "default"
  },
  "services": [
    {
      "type": "api",
      "listen": "::",
      "listen_port": 9900,
      "access_control_allow_origin": "*",
      "access_control_allow_private_network": true,
      "dashboard": true
    }
  ]
}